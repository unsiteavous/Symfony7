{% extends 'base.html.twig' %}

{% block title %}Hello ChaussureController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>
    {% for message in app.flashes('success') %}
        <div class="flash-success">
            {{ message|join('. <br>') }}
        </div>
    {% endfor %}

    <div class="example-wrapper">
        <h1>Liste des chaussures :</h1>
        <button><a href="{{ path('app_chaussure_create') }}">Créer une paire de chaussure</a></button>
        <li>

            {% for chaussure in chaussures %}
                <a href="{{ path('app_chaussure_show', {'id': chaussure.id}) }}">{{ chaussure.name }}</a>
            {% endfor %}
        </li>
        {% if (chaussures is empty) %}
            <p>Aucune chaussure trouvée.</p>
        {% endif %}
    </div>
{% endblock %}
